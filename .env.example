# =============================================================================
# Environment configuration — COPY to .env and fill in real values.
# .env is git-ignored. Never commit real credentials.
# =============================================================================

# ---- dbt target selector -----------------------------------------------------
# Which profiles.yml output to use: `duckdb` (local, zero-credential) or `snowflake`.
DBT_TARGET=duckdb

# ---- Local DuckDB warehouse (used by the `duckdb` target) -------------------
DUCKDB_PATH=/workspace/dbt/retail.duckdb

# ---- Snowflake (used by the `snowflake` target) ----------------------------
# Get these from your Snowflake account (Admin > Accounts, or the URL you log in with).
# ACCOUNT is the part before .snowflakecomputing.com, e.g. ab12345.eu-west-2.aws
SNOWFLAKE_ACCOUNT=your_account_locator.your_region.your_cloud
SNOWFLAKE_USER=RETAIL_AE_USER
SNOWFLAKE_PASSWORD=change_me
SNOWFLAKE_ROLE=RETAIL_AE_ROLE
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_DATABASE=RETAIL
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS
SNOWFLAKE_THREADS=4

# ---- Kaggle (only needed for automated dataset download) -------------------
# Alternative to ~/.kaggle/kaggle.json — see data/README.md
KAGGLE_USERNAME=
KAGGLE_KEY=
